{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chefops-api",
  "main": "src/entry.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
