{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stupiaks-ops-staging",
  "main": "src/entry-staging.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "vars": {
    "OPS_RUNTIME_ENVIRONMENT": "staging",
    "GOOGLE_DATA_AUTH_MODE": "disabled",
    "GOOGLE_DRIVE_AUTH_MODE": "disabled",
    "GOOGLE_DRIVE_BACKUP_MODE": "disabled",
    "MEDIA_PRIMARY_STORAGE": "cloudflare-r2",
    "MEDIA_RETENTION_DAYS": "30",
    "LOCAL_AUTH_MODE": "enabled",
    "LOCAL_AUTH_REGISTRATION": "disabled",
    "GOOGLE_LOGIN_MODE": "disabled",
    "BOOTSTRAP_OWNER_EMAIL": "staging-owner@stupiak.invalid"
  },
  "kv_namespaces": [
    {
      "binding": "APP_DATA_PACKS"
    }
  ],
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "stupiaks-ops-staging",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTLET_REALTIME",
        "class_name": "OutletRealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "staging-realtime-v1",
      "new_sqlite_classes": ["OutletRealtimeHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
