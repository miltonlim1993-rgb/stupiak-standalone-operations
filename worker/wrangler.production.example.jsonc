{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stupiaks-ops",
  "main": "src/entry-master-watch.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "GOOGLE_MASTER_SPREADSHEET_ID": "__GOOGLE_MASTER_SPREADSHEET_ID__",
    "GOOGLE_DATA_AUTH_MODE": "service_account",
    "GOOGLE_DRIVE_AUTH_MODE": "disabled",
    "MEDIA_PRIMARY_STORAGE": "cloudflare-r2",
    "STATVARA_OPS_BRIDGE_PORT": "__STATVARA_OPS_BRIDGE_PORT__",
    "STATVARA_OPS_API_PATH": "__STATVARA_OPS_API_PATH__"
  },
  "kv_namespaces": [
    {
      "binding": "APP_DATA_PACKS",
      "id": "__APP_DATA_PACKS_ID__"
    }
  ],
  "d1_databases": [
    {
      "binding": "OPS_DB",
      "database_name": "stupiaks-ops-realtime",
      "database_id": "__OPS_DB_ID__",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTLET_REALTIME",
        "class_name": "OutletRealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["OutletRealtimeHub"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SHEET_SYNC_QUEUE",
        "queue": "__SHEET_SYNC_QUEUE_NAME__"
      }
    ],
    "consumers": [
      {
        "queue": "__SHEET_SYNC_QUEUE_NAME__",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "retry_delay": 300,
        "dead_letter_queue": "__SHEET_SYNC_DLQ_NAME__"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "__MEDIA_BUCKET_NAME__"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/2 * * * *", "0 * * * *"]
  }
}
