{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stupiaks-ops",
  "main": "src/entry.js",
  "compatibility_date": "2026-07-25",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "APP_DATA_PACKS",
      "id": "__APP_DATA_PACKS_ID__"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTLET_REALTIME",
        "class_name": "OutletRealtimeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "realtime-v1",
      "new_sqlite_classes": ["OutletRealtimeHub"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "__MEDIA_BUCKET_NAME__"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}