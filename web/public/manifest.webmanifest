    { "name": "Stock Count", "url": "/stock", "icons": [{ "src": "/stupiaks-ops-192.png", "sizes": "192x192" }] },
    { "name": "Close Up", "url": "/close-up", "icons": [{ "src": "/stupiaks-ops-192.png", "sizes": "192x192" }] },
    { "name": "Scan Receipt", "url": "/receipts", "icons": [{ "src": "/stupiaks-ops-192.png", "sizes": "192x192" }] }
